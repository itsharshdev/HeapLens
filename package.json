{
  "name": "heaplens",
  "version": "1.0.0",
  "description": "HeapLens - Simplified Dynamic Memory Allocator using Linked Lists with Interactive Visualizer",
  "main": "bridge/server.js",
  "scripts": {
    "build:cpp": "g++ -std=c++17 -Wall -Wextra src/allocator.cpp src/main.cpp -o build/heaplens_engine.exe",
    "build:test": "g++ -std=c++17 -Wall -Wextra src/allocator.cpp tests/test_allocator.cpp -o build/test_allocator.exe",
    "build": "npm run build:cpp && npm run build:test && vite build",
    "test:cpp": "node tests/run_cpp_tests.js",
    "test:integration": "node tests/test_integration.js",
    "test:browser": "node tests/test_browser.js",
    "test": "npm run build:cpp && npm run build:test && npm run test:cpp && npm run test:integration",
    "start": "node bridge/server.js",
    "dev": "vite",
    "preview": "vite preview",
    "repl": ".\\build\\heaplens_engine.exe --interactive"
  },
  "dependencies": {
    "canvas-confetti": "^1.9.2",
    "lucide-react": "^0.344.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.160.0"
  },
  "devDependencies": {
    "@types/canvas-confetti": "^1.9.0",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@types/three": "^0.160.0",
    "@vitejs/plugin-react": "^4.3.1",
    "playwright": "^1.64.1",
    "typescript": "^5.5.4",
    "vite": "^5.4.2"
  },
  "keywords": [
    "memory-allocator",
    "data-structures",
    "linked-list",
    "first-fit",
    "coalescing",
    "educational"
  ],
  "author": "HeapLens Team",
  "license": "MIT"
}
